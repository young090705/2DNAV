<?xml version="1.0"?>
<package format="3">
  <name>full_launcher</name>
  <version>0.1.0</version>
  <description>Unified launch and configuration for MID-360, FAST-LIO and map publishing.</description>
  <maintainer email="rm-young@example.com">rm-young</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
